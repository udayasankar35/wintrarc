# WINTRARC environment variables.
#
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Run `npm run check-env -- --stage 0` to see what is still missing.
# Variables that start with NEXT_PUBLIC_ are visible in the browser. Everything
# else stays on the server. Secrets are left blank on purpose.

# --- App (needed from Stage 2) -------------------------------------------
NEXT_PUBLIC_APP_URL=

# --- Supabase (needed from Stage 0) ---------------------------------------
# Project Settings, API. The publishable key (sb_publishable_...) is safe for
# the browser. The legacy anon key also works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET, server only, needed from Stage 2. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Push notifications ----------------------------------------------------
# Stage 0 test page. Set ENABLE_PUSH_SPIKE=true only while testing push, then
# remove it. Generate the VAPID pair with `npm run vapid`.
ENABLE_PUSH_SPIKE=
# SECRET, at least 16 random characters.
PUSH_SPIKE_TOKEN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# SECRET.
VAPID_PRIVATE_KEY=
# For example mailto:you@example.com
VAPID_SUBJECT=

# --- Auth (needed from Stage 2) -------------------------------------------
# Cloudflare Turnstile site key. The secret key goes into the Supabase
# dashboard (Authentication, Attack Protection), not into this file.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Rate limiting (optional) ----------------------------------------------
UPSTASH_REDIS_REST_URL=
# SECRET.
UPSTASH_REDIS_REST_TOKEN=

# --- AI (optional, needed from Stage 7) ------------------------------------
# Without a key the AI screens say that AI is not configured.
# SECRET.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_MODEL_FAST=
# Daily token budgets. The global cap is the last line of cost defence.
AI_DAILY_TOKEN_BUDGET_USER=50000
AI_DAILY_TOKEN_BUDGET_DEMO=5000
AI_DAILY_TOKEN_BUDGET_GLOBAL=500000

# --- Scheduled jobs (needed from Stage 9) ----------------------------------
# SECRET, at least 16 random characters.
CRON_SECRET=

# --- Observability (optional, Stage 11) -------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
# SECRET.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
